{
  "name": "pulse-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest.ts",
    "brief": "node --env-file-if-exists=.env.local --import tsx scripts/brief.ts",
    "email:preview": "node --env-file-if-exists=.env.local --import tsx scripts/email-preview.ts",
    "compose": "node --env-file-if-exists=.env.local --import tsx scripts/compose.ts",
    "live-check": "node --env-file-if-exists=.env.local --import tsx scripts/live-check.ts",
    "eval": "node --import tsx scripts/eval.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "db": "node --env-file-if-exists=.env.local --import tsx scripts/db.ts",
    "rubric-check": "node --env-file-if-exists=.env.local --import tsx scripts/rubric-check.ts",
    "neon-check": "node --env-file-if-exists=.env.local --import tsx scripts/neon-check.ts",
    "vercel-build": "npm test && next build",
    "proxy-eval": "node --env-file-if-exists=.env.local --import tsx scripts/proxy-eval.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@neondatabase/serverless": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "postcss": "^8.5.29"
  }
}
