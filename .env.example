# Gemini (all AI calls). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest
# Seconds between calls; free tier is rate limited. Lower it if you have quota.
GEMINI_MIN_GAP_MS=1000

# Neon Postgres: all data lives here (briefs, domains, job queue, score cache).
# Use the POOLED connection string from the Neon dashboard (host contains "-pooler").
# The Vercel Neon integration sets DATABASE_URL for you.
# Create the tables with:  npm run db -- migrate
DATABASE_URL=

# Passcode for editing domains and AI suggestions on the settings page. REQUIRED in production:
# if it is missing, editing is disabled (never left open).
ADMIN_PASSCODE=

# Protects /api/run and /api/step. Vercel Cron sends it automatically as a Bearer token.
# Use any long random string. REQUIRED in production (if missing, the endpoints refuse all calls).
CRON_SECRET=

# Monday email (Resend). If RESEND_API_KEY or EMAIL_TO is missing, the email step is skipped, not failed.
RESEND_API_KEY=
# Up to 5 recipients, comma separated.
# With no verified domain, Resend only delivers to the email address of your own Resend account.
EMAIL_TO=
# Set to 1 to run the email step without sending (the message is stored instead). Remove to go live.
EMAIL_DRY_RUN=
# Optional. Defaults to Resend's shared test sender (onboarding@resend.dev).
EMAIL_FROM=
# Public URL of the deployed app, used for the "Read the full brief" link in the email.
APP_URL=
